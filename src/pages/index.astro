---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import media from '../content/images.json';
const github = 'https://github.com/duduescudero';
const email = 'eduardoescudero911@gmail.com';
const stack = [
  {
    number: '01',
    title: 'Interfaces',
    text: 'Do componente à experiência.',
    technologies: ['React', 'TypeScript', 'HTML & CSS'],
    project: 'Fluxo OS',
    link: '#fluxo',
  },
  {
    number: '02',
    title: 'Backend & dados',
    text: 'O que faz tudo funcionar.',
    technologies: ['C# / .NET', 'Node.js', 'Java', 'PostgreSQL'],
    project: 'Explorar projetos',
    link: '#projetos',
  },
  {
    number: '03',
    title: 'Além do navegador',
    text: 'Outras formas de resolver.',
    technologies: ['React Native', 'Python', 'OpenCV'],
    project: 'OrbitaVerde',
    link: '#orbita',
  },
];
---

<Base>
  <SiteHeader />

  <main id="conteudo" tabindex="-1">
    <section class="hero wrap" id="inicio" aria-labelledby="hero-title">
      <div class="hero-content">
        <p class="eyebrow">
          <span class="status-dot"></span> DESENVOLVEDOR EM FORMAÇÃO
        </p>
        <h1 id="hero-title">
          Ideias ganham
          <br />
          forma. <span class="muted-heading">Código</span>
          <br />
          <span class="accent-text">faz acontecer.</span>
        </h1>
        <p class="hero-description">
          Sou <strong>Eduardo Escudero</strong>, estudante de Engenharia de
          Software na FIAP. Transformo curiosidade em projetos — de interfaces a
          sistemas completos.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#projetos">
            Explorar projetos <Icon name="down" size={18} />
          </a>
          <a
            class="text-link"
            href={github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" size={19} /> Meu GitHub{' '}
            <Icon name="arrow" size={15} />
          </a>
        </div>
        <p class="opportunity">
          <span class="tiny-cross">+</span> Buscando minha primeira oportunidade
          em desenvolvimento.
        </p>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="art-coordinate top-coordinate">
          EE / LAB_001 <span>EM CONSTRUÇÃO CONTÍNUA</span>
        </div>
        <div class="orbital-system">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="orbit orbit-three"></div>
          <div class="axis horizontal"></div>
          <div class="axis vertical"></div>
          <div class="orbit-point point-one"></div>
          <div class="orbit-point point-two"></div>
          <div class="center-logo">
            <span>
              ee<span class="logo-period">.</span>
            </span>
            <small>IDEIA → CÓDIGO → EXPERIÊNCIA</small>
          </div>
        </div>
        <div class="floating-label label-front">
          <span class="bracket">&lt;/&gt;</span>
          <span>
            interfaces
            <br />
            <small>pensadas para pessoas</small>
          </span>
        </div>
        <div class="floating-label label-back">
          <span class="node-icon">⌘</span>
          <span>
            lógica & dados
            <br />
            <small>conectando as partes</small>
          </span>
        </div>
        <div class="art-coordinate bottom-coordinate">
          <span class="live-indicator"></span> APRENDER. CONSTRUIR. EVOLUIR.{' '}
          <span>01 / ∞</span>
        </div>
      </div>
      <div class="hero-bottom">
        <span>
          PORTFÓLIO PESSOAL <span class="divider-slash">/</span>{' '}
          {new Date().getFullYear()}
        </span>
        <a href="#projetos">
          Tem mais por aqui <Icon name="down" size={15} />
        </a>
      </div>
    </section>

    <div class="technology-strip" aria-label="Áreas exploradas nos projetos">
      <div class="wrap">
        <span>INTERFACES</span>
        <i>✳</i>
        <span>APIs & BACKEND</span>
        <i>✳</i>
        <span>APLICAÇÕES COMPLETAS</span>
        <i>✳</i>
        <span>APRENDIZADO NA PRÁTICA</span>
      </div>
    </div>

    <section
      class="projects section-space wrap"
      id="projetos"
      aria-labelledby="projects-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="section-index">01 /</span> PROJETOS SELECIONADOS
          </p>
          <h2 id="projects-title">
            Menos só imaginar.
            <br />
            <span class="muted-heading">Mais tirar do papel.</span>
          </h2>
        </div>
        <p>
          Problemas diferentes.
          <br />A mesma vontade de construir.
        </p>
      </div>

      <article class="featured-project" id="fluxo">
        <div class="project-visual fluxo-visual">
          <div class="visual-topline">
            <span>
              <span class="status-dot"></span> APLICAÇÃO WEB
            </span>
            <span>01 / 04</span>
          </div>
          <a
            href="https://fluxo-os.onrender.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="browser-mockup"
            aria-label="Abrir demonstração do Fluxo OS"
          >
            <div class="browser-bar">
              <span class="browser-dots">
                <i></i>
                <i></i>
                <i></i>
              </span>
              <span>fluxo-os.onrender.com</span>
              <Icon name="arrow" size={12} />
            </div>
            <img
              {...media['fluxo-dashboard']}
              alt="Dashboard real do Fluxo OS, com indicadores e ordens de serviço fictícias"
              loading="lazy"
            />
          </a>
          <span class="image-caption">DO PRIMEIRO ATENDIMENTO À ENTREGA.</span>
        </div>
        <div class="featured-copy">
          <div class="project-category">
            <span class="project-dot"></span> PROJETO PESSOAL{' '}
            <span class="live-tag">DEMO ONLINE</span>
          </div>
          <h3>
            <a href="/projetos/fluxo-os/">
              Fluxo OS<span>.</span>
            </a>
          </h3>
          <p>
            Uma assistência técnica.
            <br />
            Cada etapa sob controle.
          </p>
          <p class="project-description">
            Gestão de ordens de serviço com orçamentos versionados, permissões e
            histórico. Da interface ao banco de dados, uma aplicação completa.
          </p>
          <ul class="tags" aria-label="Tecnologias do Fluxo OS">
            <li>React</li>
            <li>TypeScript</li>
            <li>C# / .NET</li>
            <li>PostgreSQL</li>
          </ul>
          <div class="project-actions">
            <a
              class="button light"
              href="https://fluxo-os.onrender.com/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Experimentar <Icon name="arrow" size={18} />
            </a>
            <a
              class="icon-link"
              href={`${github}/fluxo-os`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Código do Fluxo OS no GitHub"
            >
              <Icon name="github" size={22} />
            </a>
          </div>
          <a class="text-link project-case-link" href="/projetos/fluxo-os/">
            Conhecer o projeto <Icon name="arrow" size={16} />
          </a>
          <small class="demo-caption">
            Demonstração com dados fictícios, em somente leitura.
          </small>
        </div>
      </article>

      <article class="featured-project portfolio-games" id="meu-onze">
        <div class="project-visual fluxo-visual meu-onze-visual">
          <div class="visual-topline">
            <span>
              <span class="status-dot"></span> FUTEBOL INTERATIVO
            </span>
            <span>02 / 04</span>
          </div>
          <a
            href="https://duduescudero.github.io/meu-onze/"
            target="_blank"
            rel="noopener noreferrer"
            class="browser-mockup"
            aria-label="Abrir Meu Onze"
          >
            <div class="browser-bar">
              <span class="browser-dots">
                <i></i>
                <i></i>
                <i></i>
              </span>
              <span>meu onze / prancheta</span>
              <Icon name="arrow" size={12} />
            </div>
            <img
              {...media['meu-onze-editor']}
              alt="Prancheta real do Meu Onze com uma escalação de exemplo"
              loading="lazy"
            />
          </a>
          <span class="image-caption">SEU TIME. SUAS ESCOLHAS.</span>
        </div>
        <div class="featured-copy">
          <div class="project-category">
            <span class="project-dot"></span> PROJETO PESSOAL{' '}
            <span class="live-tag">APLICAÇÃO ONLINE</span>
          </div>
          <h3>
            <a href="/projetos/meu-onze/">
              Meu Onze<span>.</span>
            </a>
          </h3>
          <p>
            Um interesse pessoal.
            <br />
            Quatro formas de entrar em campo.
          </p>
          <p class="project-description">
            Prancheta de futebol, jogadores personalizados e quatro minigames.
            Interface, regras e compartilhamento em uma aplicação que você pode
            experimentar agora.
          </p>
          <ul class="tags" aria-label="Tecnologias do Meu Onze">
            <li>React</li>
            <li>TypeScript</li>
            <li>SVG</li>
            <li>IndexedDB</li>
          </ul>
          <div class="project-actions">
            <a
              class="button light"
              href="https://duduescudero.github.io/meu-onze/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Entrar em campo <Icon name="arrow" size={18} />
            </a>
            <a
              class="icon-link"
              href={`${github}/meu-onze`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Código do Meu Onze no GitHub"
            >
              <Icon name="github" size={22} />
            </a>
          </div>
          <a class="text-link project-case-link" href="/projetos/meu-onze/">
            Conhecer o projeto <Icon name="arrow" size={16} />
          </a>
          <small class="demo-caption">
            Sem cadastro. Elencos datados e salvamento no navegador.
          </small>
        </div>
      </article>
      <div class="project-grid">
        <article class="secondary-project" id="orbita">
          <div class="secondary-visual orbita-visual">
            <span class="visual-number">03 / 04</span>
            <div class="orbita-title" aria-hidden="true">
              <span class="orbita-symbol">◎</span> orbita<span>verde</span>
              <small>TECNOLOGIA PARA OLHAR MAIS LONGE.</small>
            </div>
            <div class="phone-frame">
              <img
                {...media['orbita-mobile']}
                alt="Interface real do aplicativo OrbitaVerde, com alertas ambientais de demonstração"
                loading="lazy"
              />
            </div>
            <div class="vision-frame">
              <img
                {...media['orbita-vision']}
                alt="Vídeo processado pelo detector de fogo e fumaça do OrbitaVerde"
                loading="lazy"
              />
              <span>VISÃO COMPUTACIONAL / PYTHON</span>
            </div>
          </div>
          <div class="secondary-copy">
            <p class="project-category">
              PROJETO ACADÊMICO <span>FIAP</span>
            </p>
            <div class="project-title-row">
              <h3>
                <a href="/projetos/orbita-verde/">OrbitaVerde</a>
              </h3>
              <a
                class="round-link"
                href={`${github}/orbita-verde`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Explorar OrbitaVerde no GitHub"
              >
                <Icon name="arrow" />
              </a>
            </div>
            <p>
              Um problema ambiental, diferentes caminhos técnicos. APIs, mobile
              e visão computacional em módulos independentes.
            </p>
            <ul class="tags">
              <li>Java</li>
              <li>C#</li>
              <li>React Native</li>
              <li>Python</li>
            </ul>
            <a
              class="text-link project-case-link"
              href="/projetos/orbita-verde/"
            >
              Conhecer o projeto <Icon name="arrow" size={16} />
            </a>
          </div>
        </article>
        <article class="secondary-project" id="pokeidle">
          <div class="secondary-visual poke-visual">
            <span class="visual-number">04 / 04</span>
            <div class="poke-title" aria-hidden="true">
              <span class="pixel-star">✦</span> PokeIdle<span>Manager</span>
            </div>
            <div class="desktop-frame">
              <img
                {...media['pokeidle-desktop']}
                alt="Interface Windows Forms do PokeIdle Manager com contas e métricas fictícias"
                loading="lazy"
              />
            </div>
            <span class="poke-caption">
              UM INTERESSE PESSOAL. UM DESAFIO DE ENGENHARIA.
            </span>
          </div>
          <div class="secondary-copy">
            <p class="project-category">
              PROJETO PESSOAL <span>DESKTOP & EVENTOS</span>
            </p>
            <div class="project-title-row">
              <h3>
                <a href="/projetos/pokeidle-manager/">PokeIdle Manager</a>
              </h3>
              <a
                class="round-link"
                href={`${github}/pokeidle-manager`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Explorar PokeIdle Manager no GitHub"
              >
                <Icon name="arrow" />
              </a>
            </div>
            <p>
              Um hobby que virou aplicação. Múltiplas sessões, reconexão e
              confirmação de operações em uma interface desktop.
            </p>
            <ul class="tags">
              <li>Node.js</li>
              <li>JavaScript</li>
              <li>C#</li>
              <li>WebSocket</li>
            </ul>
            <a
              class="text-link project-case-link"
              href="/projetos/pokeidle-manager/"
            >
              Conhecer o projeto <Icon name="arrow" size={16} />
            </a>
          </div>
        </article>
      </div>
      <a
        class="all-projects text-link"
        href={github + '?tab=repositories'}
        target="_blank"
        rel="noopener noreferrer"
      >
        Explore o código e a documentação no GitHub{' '}
        <Icon name="arrow" size={18} />
      </a>
    </section>

    <section
      class="about section-space"
      id="sobre"
      aria-labelledby="about-title"
    >
      <div class="wrap about-grid">
        <div>
          <p class="eyebrow">
            <span class="section-index">02 /</span> ALÉM DO CÓDIGO
          </p>
          <h2 id="about-title">
            Curiosidade
            <br />
            que vira <span class="accent-text">projeto.</span>
          </h2>
          <div class="about-signature">
            <span class="small-monogram">ee.</span>
            <span>
              Eduardo Escudero<small>ENGENHARIA DE SOFTWARE · FIAP</small>
            </span>
          </div>
        </div>
        <div class="about-copy">
          <p>
            Gosto de entender como as coisas funcionam. E gosto ainda mais de
            descobrir isso <strong>construindo alguma coisa.</strong>
          </p>
          <p>
            Na Engenharia de Software, encontrei espaço para conectar essas duas
            vontades. Meus projetos passam por interfaces, APIs, aplicações
            desktop e mobile — cada um traz um problema novo e uma oportunidade
            de aprender.
          </p>
          <p>
            Estou buscando minha primeira oportunidade em desenvolvimento, para
            contribuir com uma equipe, aprofundar minha prática e continuar
            evoluindo.
          </p>
          <a class="text-link" href={'mailto:' + email}>
            Vamos conversar <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </section>

    <section
      class="stack section-space wrap"
      id="stack"
      aria-labelledby="stack-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="section-index">03 /</span> MINHA CAIXA DE FERRAMENTAS
          </p>
          <h2 id="stack-title">
            Tecnologias na prática<span class="accent-text">.</span>
          </h2>
        </div>
        <p>
          Conhecimento construído
          <br />
          em projetos reais.
        </p>
      </div>
      <div class="stack-grid">
        {stack.map((item) => (
          <article class="stack-group">
            <span class="stack-index">
              {item.number}
              <Icon name="code" size={25} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <ul>
              {item.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
            <a href={item.link}>
              {item.project}
              <Icon name="arrow" size={16} />
            </a>
          </article>
        ))}
      </div>
      <div class="tooling">
        <span>NO DIA A DIA DOS PROJETOS</span>
        <p>
          Git & GitHub <i>/</i> Docker <i>/</i> GitHub Actions <i>/</i> Testes
          automatizados
        </p>
      </div>
    </section>

    <section
      class="contact section-space"
      id="contato"
      aria-labelledby="contact-title"
    >
      <div class="wrap contact-inner">
        <p class="eyebrow">
          <span class="section-index">04 /</span> PRÓXIMA CONEXÃO
        </p>
        <h2 id="contact-title">
          Boas ideias começam
          <br />
          com uma <span class="accent-text">conversa.</span>
          <span class="contact-star" aria-hidden="true">
            ✳
          </span>
        </h2>
        <p>
          Tem uma oportunidade de estágio ou quer conversar sobre tecnologia?
          <br />
          Meu próximo desafio pode começar por aqui.
        </p>
        <div class="contact-actions">
          <a class="button primary" href={'mailto:' + email}>
            Vamos conversar <Icon name="arrow" size={19} />
          </a>
          <a
            class="text-link"
            href={github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" /> GitHub <Icon name="arrow" size={15} />
          </a>
        </div>
        <div class="email-line">
          <a href={'mailto:' + email}>{email}</a>
          <button
            type="button"
            data-copy-email
            aria-label="Copiar endereço de e-mail"
          >
            <Icon name="copy" size={17} />
          </button>
        </div>
        <p id="copy-status" role="status" aria-live="polite"></p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
