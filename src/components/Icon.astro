  github:
    'M9 19c-4 1-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-2.7c3.3-.4 6.8-1.6 6.8-7.4A5.8 5.8 0 0 0 19.2 4a5.4 5.4 0 0 0-.1-4S17.8-.4 15 1.5a13.5 13.5 0 0 0-7 0C5.2-.4 3.9 0 3.9 0a5.4 5.4 0 0 0-.1 4 5.8 5.8 0 0 0-1.6 4c0 5.8 3.5 7 6.8 7.4A3.5 3.5 0 0 0 8 18v4',
};
---

<svg
  width={size}
